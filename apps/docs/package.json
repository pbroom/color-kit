{
  "name": "@color-kit/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run docs:api && vite",
    "build": "pnpm run docs:api && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs && pagefind --site dist && node scripts/check-bundle.mjs",
    "docs:api": "vite-node scripts/api/generate.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "tokens": "vite-node scripts/write-tokens.ts",
    "profile:color-area": "node scripts/profile-color-area.mjs",
    "test:color-area-drag": "node scripts/test-color-area-drag.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@color-kit/core": "workspace:*",
    "@color-kit/driver": "workspace:*",
    "@color-kit/react": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mdx-js/rollup": "^3.0.0",
    "clsx": "^2.1.1",
    "color-kit": "workspace:*",
    "d3-hierarchy": "^3.1.2",
    "d3-shape": "^3.2.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx-frontmatter": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@shikijs/langs": "^4.0.0",
    "@shikijs/rehype": "^4.0.0",
    "@shikijs/themes": "^4.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "pagefind": "^1.5.2",
    "shiki": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4",
    "yaml": "^2.9.1"
  }
}
